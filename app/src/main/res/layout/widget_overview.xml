<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" style="@style/WidgetHeading" android:layout_width="0dp" android:layout_weight="1" android:text="Today"/>
        <TextView android:id="@+id/widget_date" style="@style/WidgetCaption" android:layout_width="wrap_content"/>
        <ImageView android:id="@+id/widget_avatar" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="8dp"
            android:src="@drawable/ic_bite" android:contentDescription="@string/widget_profile" android:scaleType="centerCrop"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginVertical="4dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_energy_ring" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:scaleType="fitCenter" android:contentDescription="@null"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_energy" style="@style/WidgetHeading" android:layout_width="match_parent" android:textSize="26sp" android:text="— kcal" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/widget_energy_target" style="@style/WidgetCaption" android:layout_width="match_parent" android:text="Daily goal"/>
            <ProgressBar android:id="@+id/widget_energy_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent"
                android:layout_height="4dp" android:layout_marginTop="6dp" android:progressTint="@color/widget_accent" android:progressBackgroundTint="@color/widget_tile"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_macros" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginBottom="6dp">
        <TextView android:id="@+id/widget_protein" style="@style/WidgetMacro" android:text="Protein"/>
        <TextView android:id="@+id/widget_carbs" style="@style/WidgetMacro" android:text="Carbs"/>
        <TextView android:id="@+id/widget_fat" style="@style/WidgetMacro" android:text="Fat"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_water_section" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="6dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widget_water_summary" style="@style/WidgetCaption" android:layout_width="match_parent" android:text="@string/widget_water_name" android:maxLines="1"/>
            <ProgressBar android:id="@+id/widget_water_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent"
                android:layout_height="4dp" android:layout_marginTop="5dp" android:progressTint="@color/widget_accent" android:progressBackgroundTint="@color/widget_tile"/>
        </LinearLayout>
        <TextView android:id="@+id/widget_water_add" android:layout_width="76dp" android:layout_height="44dp" android:gravity="center"
            android:layout_marginStart="8dp" android:background="@drawable/widget_button" android:text="+250 ml" android:textSize="12sp"
            android:fontFamily="@font/inter_variable" android:textColor="@color/widget_foreground" android:textStyle="bold"/>
    </LinearLayout>
    <include layout="@layout/widget_actions"/>
</LinearLayout>
