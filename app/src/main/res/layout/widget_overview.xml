<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="8bitBites" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_foreground" />
        <TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/widget_foreground" />
    </LinearLayout>
    <TextView android:id="@+id/widget_energy" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="— kcal" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/widget_foreground" android:maxLines="1" />
    <TextView android:id="@+id/widget_macros" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Protein · Carbs · Fat" android:textSize="12sp" android:textColor="@color/widget_foreground" android:maxLines="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_avatar" android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_bite" android:contentDescription="@string/widget_profile" android:scaleType="centerCrop" />
        <TextView android:id="@+id/widget_add" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center"
            android:text="@string/widget_add" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widget_foreground" android:contentDescription="@string/widget_add" />
        <TextView android:id="@+id/widget_ai" android:layout_width="56dp" android:layout_height="match_parent" android:gravity="center"
            android:text="AI" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_foreground" android:contentDescription="@string/widget_ai" />
        <TextView android:id="@+id/widget_camera" android:layout_width="64dp" android:layout_height="match_parent" android:gravity="center"
            android:text="@string/widget_camera" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widget_foreground" android:contentDescription="@string/widget_camera" />
    </LinearLayout>
</LinearLayout>
