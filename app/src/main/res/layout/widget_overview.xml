<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="14dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="8bitBites" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/widget_foreground"/>
        <TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_muted"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_energy" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="— kcal" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/widget_accent" android:maxLines="1" android:ellipsize="end"/>
    <ProgressBar android:id="@+id/widget_energy_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent"
        android:layout_height="6dp" android:layout_marginTop="5dp" android:progressTint="@color/widget_accent" android:progressBackgroundTint="@color/widget_tile"/>
    <TextView android:id="@+id/widget_macros" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="Protein · Carbs · Fat" android:textSize="12sp" android:textColor="@color/widget_foreground" android:maxLines="2"/>
    <LinearLayout android:id="@+id/widget_water_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widget_water_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_water_name" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_foreground" android:maxLines="1"/>
            <ProgressBar android:id="@+id/widget_water_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent"
                android:layout_height="5dp" android:progressTint="@color/widget_accent" android:progressBackgroundTint="@color/widget_tile"/>
        </LinearLayout>
        <TextView android:id="@+id/widget_water_add" android:layout_width="76dp" android:layout_height="44dp" android:gravity="center"
            android:layout_marginStart="8dp" android:background="@drawable/widget_button" android:text="+250 ml" android:textSize="12sp"
            android:textColor="@color/widget_accent" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_actions" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_avatar" android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_bite"
            android:contentDescription="@string/widget_profile" android:scaleType="centerCrop"/>
        <TextView android:id="@+id/widget_add" style="@style/WidgetDrinkButton" android:text="@string/widget_add"/>
        <TextView android:id="@+id/widget_ai" style="@style/WidgetDrinkButton" android:text="AI"/>
        <TextView android:id="@+id/widget_camera" style="@style/WidgetDrinkButton" android:text="@string/widget_camera"/>
    </LinearLayout>
</LinearLayout>
