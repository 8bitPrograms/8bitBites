<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/widget_water_name" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/widget_foreground"/>
        <TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_muted"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_water_amount" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="0 ml" android:textSize="26sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_accent" android:maxLines="1"/>
    <TextView android:id="@+id/widget_water_target" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_water_description" android:textSize="12sp" android:textColor="@color/widget_muted" android:maxLines="1"/>
    <ProgressBar android:id="@+id/widget_water_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent"
        android:layout_height="4dp" android:layout_marginTop="4dp" android:progressTint="@color/widget_accent" android:progressBackgroundTint="@color/widget_tile" android:progress="0"/>
    <ImageView android:id="@+id/widget_water_vessels" android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="4dp"
        android:scaleType="fitCenter" android:contentDescription="@string/widget_water_description"/>
    <TextView android:id="@+id/widget_water_breakdown" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="10sp" android:textColor="@color/widget_muted" android:maxLines="2" android:ellipsize="end"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_drink_one" style="@style/WidgetDrinkButton"/>
        <TextView android:id="@+id/widget_drink_two" style="@style/WidgetDrinkButton"/>
        <TextView android:id="@+id/widget_drink_three" style="@style/WidgetDrinkButton"/>
    </LinearLayout>
</LinearLayout>
