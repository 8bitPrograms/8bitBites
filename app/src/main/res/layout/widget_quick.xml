<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="10dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_avatar" android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_bite"
            android:contentDescription="@string/widget_profile" android:scaleType="centerCrop"/>
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:text="@string/widget_quick_name" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widget_foreground"/>
        <TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/widget_muted"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp">
        <TextView android:id="@+id/widget_add" style="@style/WidgetDrinkButton" android:text="@string/widget_add"/>
        <TextView android:id="@+id/widget_ai" style="@style/WidgetDrinkButton" android:text="AI"/>
        <TextView android:id="@+id/widget_camera" style="@style/WidgetDrinkButton" android:text="@string/widget_camera"/>
    </LinearLayout>
</LinearLayout>
